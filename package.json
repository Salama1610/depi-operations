{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci --include=dev --include=optional",
    "dev": "next dev",
    "dev:cloudflare": "vite",
    "build": "next build",
    "build:cloudflare": "node scripts/build-verified.mjs",
    "start": "next start",
    "start:cloudflare": "vinext start",
    "test": "node --experimental-strip-types --test tests/domain.test.mjs tests/integration.test.mjs tests/supabase-schema.test.mjs tests/data-adapter.test.mjs tests/account-secrets.test.mjs tests/rpc-transport.test.mjs tests/service-link-platform.test.mjs tests/qc-assignment.test.mjs tests/spreadsheet.test.mjs tests/sheet-mapping.test.mjs",
    "test:postgres": "node --experimental-strip-types --test tests/integration-postgres.test.mjs",
    "test:postgres-rpc": "node --experimental-strip-types --test tests/integration-postgres-rpc.test.mjs",
    "migrate:supabase": "node --experimental-strip-types scripts/migrate-d1-to-supabase.mjs",
    "test:all": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern vendor",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.7.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

# Configure real values through protected deployment settings, never source control.
AUTOMATION_HMAC_SECRET=
AUTOMATION_ACTOR_EMAIL=
VAULT_URL=
VAULT_TOKEN=
BACKUP_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=depi-evidence
# The deployed Worker reaches PostgreSQL over HTTPS (public.depi_execute) using
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY. SUPABASE_DB_URL (pooler connection
# string, server-only) is for Node tooling/tests; set SUPABASE_DB_TRANSPORT=postgres
# to force the wire client where TLS to the pooler can be validated.
SUPABASE_DB_URL=
SUPABASE_DB_TRANSPORT=
# Developer previews only: set to 1 to allow the local D1/R2 bindings when Supabase is not configured. Never set in production.
LOCAL_DATA_FALLBACK=
